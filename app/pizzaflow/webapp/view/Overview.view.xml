<mvc:View
  controllerName="pizzaflow.controller.Overview"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core"
  core:require="{ formatter: 'pizzaflow/model/formatter' }"
>
  <f:DynamicPage id="overviewPage" toggleHeaderOnTitleClick="false">
    <f:title>
      <f:DynamicPageTitle id="overviewPageTitle">
        <f:heading>
          <Title id="overviewTitle" text="{i18n>overviewTitle}" level="H2" />
        </f:heading>
        <f:expandedContent>
          <Text id="overviewSubtitle" text="{i18n>overviewSubtitle}" />
        </f:expandedContent>
        <f:actions>
          <Button id="refreshButton" text="{i18n>refresh}" icon="sap-icon://refresh" press=".onRefresh" />
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <f:content>
      <!-- One responsive grid: KPI tiles in a full-width row, then two tables -->
      <l:Grid id="overviewGrid" defaultSpan="XL6 L6 M12 S12" containerQuery="true" hSpacing="1">
        <!--
          Key figures. The HBox is bound to the OData FUNCTION getOverview().
          "(...)" marks a deferred operation binding: the function is called
          when the controller invokes it (see Overview.controller.js).
        -->
        <HBox id="kpiTiles" wrap="Wrap" binding="{/getOverview(...)}">
          <layoutData>
            <l:GridData span="XL12 L12 M12 S12" />
          </layoutData>
          <GenericTile
            id="kpiTotalOrders"
            header="{i18n>kpiTotalOrders}"
            subheader="{i18n>kpiTotalOrdersSub}"
            press=".onNavigateToOrders"
            class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
          >
            <TileContent id="kpiTotalOrdersContent">
              <NumericContent id="kpiTotalOrdersValue" value="{totalOrders}" icon="sap-icon://sales-order" withMargin="false" />
            </TileContent>
          </GenericTile>

          <GenericTile
            id="kpiPendingOrders"
            header="{i18n>kpiPendingOrders}"
            subheader="{i18n>kpiPendingOrdersSub}"
            press=".onNavigateToOrders"
            class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
          >
            <TileContent id="kpiPendingOrdersContent">
              <NumericContent
                id="kpiPendingOrdersValue"
                value="{pendingOrders}"
                valueColor="Neutral"
                icon="sap-icon://pending"
                withMargin="false"
              />
            </TileContent>
          </GenericTile>

          <GenericTile
            id="kpiRevenue"
            header="{i18n>kpiRevenue}"
            subheader="{i18n>kpiRevenueSub}"
            press=".onNavigateToOrders"
            class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
          >
            <TileContent id="kpiRevenueContent" unit="{currency}">
              <NumericContent
                id="kpiRevenueValue"
                value="{confirmedRevenue}"
                valueColor="Good"
                truncateValueTo="10"
                withMargin="false"
              />
            </TileContent>
          </GenericTile>

          <GenericTile
            id="kpiLowStock"
            header="{i18n>kpiLowStock}"
            subheader="{i18n>kpiLowStockSub}"
            press=".onNavigateToMaterials"
            class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
          >
            <TileContent id="kpiLowStockContent">
              <NumericContent
                id="kpiLowStockValue"
                value="{lowStockMaterials}"
                valueColor="{= ${path: 'lowStockMaterials', targetType: 'any'} > 0 ? 'Critical' : 'Good' }"
                icon="sap-icon://product"
                withMargin="false"
              />
            </TileContent>
          </GenericTile>
        </HBox>

          <!-- Recent sales orders: OData query options $orderby and $top (via length) -->
          <Table
            id="recentOrdersTable"
            ariaLabelledBy="recentOrdersTitle"
            items="{
              path: '/SalesOrders',
              parameters: { $orderby: 'createdAt desc' },
              length: 5
            }"
            noDataText="{i18n>recentOrdersNoData}"
          >
            <headerToolbar>
              <OverflowToolbar id="recentOrdersToolbar">
                <Title id="recentOrdersTitle" text="{i18n>recentOrdersTitle}" level="H3" />
                <ToolbarSpacer />
                <Link id="recentOrdersShowAll" text="{i18n>showAll}" press=".onNavigateToOrders" />
              </OverflowToolbar>
            </headerToolbar>
            <columns>
              <Column id="recentOrderNumberColumn">
                <Text text="{i18n>salesOrder}" />
              </Column>
              <Column id="recentOrderDateColumn" minScreenWidth="Tablet" demandPopin="true">
                <Text text="{i18n>createdOn}" />
              </Column>
              <Column id="recentOrderStatusColumn">
                <Text text="{i18n>status}" />
              </Column>
              <Column id="recentOrderAmountColumn" hAlign="End">
                <Text text="{i18n>totalAmount}" />
              </Column>
            </columns>
            <items>
              <ColumnListItem type="Navigation" press=".onOrderPress">
                <ObjectIdentifier title="{orderNumber}" />
                <Text text="{createdAt}" />
                <ObjectStatus
                  text="{ path: 'status', formatter: 'formatter.orderStatusText.bind($controller)' }"
                  state="{ path: 'status', formatter: 'formatter.orderStatusState' }"
                  icon="{ path: 'status', formatter: 'formatter.orderStatusIcon' }"
                />
                <ObjectNumber number="{totalAmount}" unit="{currency}" />
              </ColumnListItem>
            </items>
          </Table>

          <!-- Materials below minimum stock: OData $filter comparing two properties -->
          <Table
            id="replenishmentTable"
            ariaLabelledBy="replenishmentTitle"
            items="{
              path: '/Materials',
              parameters: { $filter: 'stockQuantity lt minimumStock', $orderby: 'name' }
            }"
            noDataText="{i18n>replenishmentNoData}"
          >
            <headerToolbar>
              <OverflowToolbar id="replenishmentToolbar">
                <Title id="replenishmentTitle" text="{i18n>replenishmentTitle}" level="H3" />
                <ToolbarSpacer />
                <Link id="replenishmentShowAll" text="{i18n>showAll}" press=".onNavigateToMaterials" />
              </OverflowToolbar>
            </headerToolbar>
            <columns>
              <Column id="replenishmentMaterialColumn">
                <Text text="{i18n>material}" />
              </Column>
              <Column id="replenishmentAvailableColumn" hAlign="End">
                <Text text="{i18n>availableQuantity}" />
              </Column>
              <Column id="replenishmentMinimumColumn" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                <Text text="{i18n>minimumStock}" />
              </Column>
              <Column id="replenishmentStatusColumn">
                <Text text="{i18n>stockStatus}" />
              </Column>
            </columns>
            <items>
              <ColumnListItem type="Navigation" press=".onNavigateToMaterials">
                <ObjectIdentifier title="{name}" text="{ID}" />
                <ObjectNumber number="{stockQuantity}" unit="{unitOfMeasure}" />
                <ObjectNumber number="{minimumStock}" unit="{unitOfMeasure}" />
                <ObjectStatus
                  text="{ path: 'stockStatus', formatter: 'formatter.stockStatusText.bind($controller)' }"
                  state="{ path: 'stockStatus', formatter: 'formatter.stockStatusState' }"
                  icon="{ path: 'stockStatus', formatter: 'formatter.stockStatusIcon' }"
                />
              </ColumnListItem>
            </items>
          </Table>
      </l:Grid>
    </f:content>
  </f:DynamicPage>
</mvc:View>
